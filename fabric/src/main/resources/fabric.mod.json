{
  "schemaVersion": 1,
  "id": "conclave",
  "version": "${version}",
  "name": "Conclave",
  "license": "MPL-2.0",
  "description": "Declarative encounter framework. Development foundation; gameplay adapters are in progress.",
  "environment": "*",
  "mixins": ["conclave.mixins.json"],
  "entrypoints": {
    "main": [{"adapter": "kotlin", "value": "dev.conclave.fabric.Conclave"}],
    "client": [{"adapter": "kotlin", "value": "dev.conclave.fabric.client.ConclaveClient"}]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "=26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
  }
}
